# Copiar a staging.env y ajustar
ENTORNO=staging
DEBUG=false
HOST=0.0.0.0
PUERTO=8000

# Puertos staging en host (evitan conflicto con desarrollo local)
STAGING_BACKEND_PORT=18000
STAGING_FRONTEND_PORT=15173

# Ajustar según infraestructura real
# DATABASE_URL=postgresql://usuario:password@host:5432/analyticspredict

# Auth para staging
AUTH_STORE_DRIVER=postgres
AUTH_SECRET_KEY=cambiar-en-staging

# Recuperación de contraseña por SMTP en staging
# Opción rápida local (sin proveedor externo): MailHog en el mismo compose
AUTH_RESET_EMAIL_MODE=smtp
AUTH_FRONTEND_URL=http://localhost:15173
AUTH_SMTP_HOST=mailhog
AUTH_SMTP_PORT=1025
AUTH_SMTP_USER=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_FROM=no-reply@analyticspredict.local
AUTH_SMTP_STARTTLS=false
AUTH_SMTP_SSL=false

# UI web de MailHog (bandeja local)
STAGING_SMTP_UI_PORT=18025
