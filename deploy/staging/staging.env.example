# Compose local privado single-user. Copiar a staging.env; no versionar secretos.
ENTORNO=desarrollo
DEBUG=false
# Bind interno al contenedor; los puertos publicados quedan solo en loopback del host.
HOST=0.0.0.0
PUERTO=8000

# Puertos staging en host (evitan conflicto con desarrollo local)
STAGING_BACKEND_PORT=18000
STAGING_FRONTEND_PORT=15173

# Definir DATABASE_URL en el archivo local protegido antes del arranque.
DATABASE_URL=
