# ══════════════════════════════════════════════════════════════
# Variables de entorno - Analizador NBA
# ══════════════════════════════════════════════════════════════
# Copia este archivo a .env y ajusta los valores según tu entorno

# Entorno: desarrollo, pruebas, produccion
ENTORNO=desarrollo

# Modo debug (true/false)
DEBUG=true

# Servidor
HOST=127.0.0.1
PUERTO=8000

# Rutas de datos
RUTA_MODELO=datos/modelo_entrenado.npz
RUTA_EQUIPOS=datos/equipos_nba.json

# Parámetros del modelo
PROB_MIN_RECOMENDACION=0.55
EDGE_MIN_VALOR=0.10

# CORS (separados por coma, solo para producción)
# ORIGENES_CORS=https://miapp.com,https://www.miapp.com
