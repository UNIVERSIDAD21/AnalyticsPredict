# Backend privado single-user. Copiar a backend/.env; nunca versionar valores reales.
DATABASE_URL=
# Opcional: por defecto ~/.local/share/analyticspredict/modelo_nba_activo.npz.
# Solo el comando de entrenamiento explícito publica este artefacto.
# ANALYTICSPREDICT_MODELO_NBA_ACTIVO=/ruta/privada/modelo_nba_activo.npz

# Solo loopback para uso local. Si cambia la topología, proteger acceso en infraestructura.
HOST=127.0.0.1
PUERTO=8000

# Calidad y explicabilidad; no son gates comerciales.
FEATURE_CALIDAD_SCORECARD=false
FEATURE_ALERTAS_CALIDAD=false
FEATURE_CONTRATO_EXPLICACION_V1=false
FEATURE_EXPLICABILIDAD_UI=false
