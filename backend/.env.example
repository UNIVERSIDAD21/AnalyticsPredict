# Variables de entorno backend
# Copiar a backend/.env y completar

# Conexion Neon/PostgreSQL
DATABASE_URL=

# Auth storage driver: sqlite (dev local) | postgres (staging/prod)
AUTH_STORE_DRIVER=sqlite
# Solo aplica si AUTH_STORE_DRIVER=sqlite
AUTH_DB_PATH=backend/data/auth.db
# Secreto para firmar tokens auth
AUTH_SECRET_KEY=cambiar-en-staging-y-produccion

# Recuperación de contraseña
# dev  -> devuelve reset_token_dev en la respuesta (solo local)
# smtp -> envía correo real y NO expone token en API
AUTH_RESET_EMAIL_MODE=dev
AUTH_FRONTEND_URL=http://localhost:5173
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_USER=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_FROM=no-reply@analyticspredict.local
AUTH_SMTP_STARTTLS=true
AUTH_SMTP_SSL=false

# Notificaciones B4 (preferencias + historial)
NOTIFICACIONES_DB_PATH=backend/data/notificaciones.db
NOTIF_MAX_INTENTOS_ALERTAS_PARTIDOS=3
NOTIF_MAX_INTENTOS_ALERTAS_SUSCRIPCION=4
NOTIF_MAX_INTENTOS_RESUMEN_SEMANAL=2

# BLOQUE 08 - FEATURE FLAGS
# Activa cálculo y lectura de scorecard de calidad
FEATURE_CALIDAD_SCORECARD=false
# Activa sistema de alertas de calidad (dq_alerts)
FEATURE_ALERTAS_CALIDAD=false
# Activa contrato canónico de explicación v1
FEATURE_CONTRATO_EXPLICACION_V1=false
# Señal backend para habilitación de UI de explicabilidad
FEATURE_EXPLICABILIDAD_UI=false
