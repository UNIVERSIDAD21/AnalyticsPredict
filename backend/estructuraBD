vista_resumen_apuestas:
SELECT
  u.id AS usuario_id,
  u.nombre AS usuario,
  count(*) AS total_apuestas,
  sum(
    CASE
      WHEN a.resultado::text = 'PENDIENTE'::text THEN 1
      ELSE 0
    END
  ) AS pendientes,
  sum(
    CASE
      WHEN a.resultado::text = 'GANADA'::text THEN 1
      ELSE 0
    END
  ) AS ganadas,
  sum(
    CASE
      WHEN a.resultado::text = 'PERDIDA'::text THEN 1
      ELSE 0
    END
  ) AS perdidas,
  sum(
    CASE
      WHEN a.resultado::text = 'PUSH'::text THEN 1
      ELSE 0
    END
  ) AS push,
  round(
    sum(
      CASE
        WHEN a.resultado::text = 'GANADA'::text THEN 1
        ELSE 0
      END
    )::numeric / NULLIF(
      sum(
        CASE
          WHEN a.resultado::text = ANY (
            ARRAY[
              'GANADA'::character varying,
              'PERDIDA'::character varying
            ]::text[]
          ) THEN 1
          ELSE 0
        END
      ),
      0
    )::numeric * 100::numeric,
    2
  ) AS winrate,
  sum(a.ganancia) AS ganancia_total,
  sum(
    CASE
      WHEN a.resultado::text <> 'PENDIENTE'::text THEN a.stake
      ELSE 0::numeric
    END
  ) AS total_apostado,
  round(
    sum(a.ganancia) / NULLIF(
      sum(
        CASE
          WHEN a.resultado::text <> 'PENDIENTE'::text THEN a.stake
          ELSE 0::numeric
        END
      ),
      0::numeric
    ) * 100::numeric,
    2
  ) AS roi
FROM
  usuarios u
  LEFT JOIN apuestas a ON u.id = a.usuario_id
GROUP BY
  u.id,
  u.nombre

vista_resumen_calibracion:

SELECT
  mercado,
  origen,
  count(*) AS n_predicciones,
  round(avg(p_raw), 4) AS promedio_p_raw,
  round(avg(COALESCE(p_calibrada, p_raw)), 4) AS promedio_p_efectiva,
  round(
    avg(
      CASE
        WHEN outcome_binario THEN 1.0
        ELSE 0.0
      END
    ),
    4
  ) AS frecuencia_real,
  round(
    avg(p_raw) - avg(
      CASE
        WHEN outcome_binario THEN 1.0
        ELSE 0.0
      END
    ),
    4
  ) AS sesgo_bruto,
  round(
    avg(
      power(
        p_raw - CASE
          WHEN outcome_binario THEN 1.0
          ELSE 0.0
        END,
        2::numeric
      )
    ),
    4
  ) AS brier_score_raw,
  round(
    avg(
      power(
        COALESCE(p_calibrada, p_raw) - CASE
          WHEN outcome_binario THEN 1.0
          ELSE 0.0
        END,
        2::numeric
      )
    ),
    4
  ) AS brier_score_efectivo,
  round(stddev(p_raw), 4) AS sharpness,
  min(fecha_partido) AS fecha_min,
  max(fecha_partido) AS fecha_max
FROM
  vista_predicciones_para_calibracion
GROUP BY
  mercado,
  origen
ORDER BY
  mercado,
  origen
