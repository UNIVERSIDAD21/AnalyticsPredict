vista_alertas_activas:
SELECT
  id,
  timestamp_deteccion,
  mercado,
  tipo_alerta,
  severidad,
  metrica_afectada,
  valor_actual,
  valor_umbral,
  mensaje,
  EXTRACT(
    day
    FROM
      now() - timestamp_deteccion
  ) AS dias_sin_resolver
FROM
  alertas_calibracion
WHERE
  resuelta = false
ORDER BY
  (
    CASE severidad
      WHEN 'CRITICAL'::text THEN 1
      WHEN 'WARNING'::text THEN 2
      ELSE 3
    END
  ),
  timestamp_deteccion DESC

vista_analisis_apuestas:
SELECT
  a.id,
  a.usuario_id,
  u.nombre AS usuario_nombre,
  a.equipo_local,
  a.equipo_visitante,
  a.fecha_partido,
  a.mercado,
  a.lado,
  a.linea,
  a.cuota,
  a.cuota_over,
  a.cuota_under,
  a.stake,
  a.devig_metodo,
  a.devig_overround,
  CASE
    WHEN a.devig_overround IS NOT NULL THEN round((a.devig_overround - 1.0) * 100::numeric, 2)
    ELSE NULL::numeric
  END AS vig_porcentaje,
  a.devig_p_mkt_raw,
  a.devig_p_mkt_fair,
  a.probabilidad_sistema,
  a.edge_real,
  round(
    (
      a.probabilidad_sistema - COALESCE(a.devig_p_mkt_raw, 1.0 / a.cuota)
    ) * 100::numeric,
    2
  ) AS edge_raw_porcentaje,
  round(
    COALESCE(a.edge_real, 0::numeric) * 100::numeric,
    2
  ) AS edge_real_porcentaje,
  a.valor_esperado,
  a.score_total,
  a.score_componentes,
  a.kelly_full,
  a.kelly_fraccional,
  a.fraccion_kelly,
  a.stake_porcentaje,
  a.bankroll_momento,
  CASE
    WHEN a.bankroll_momento IS NOT NULL
    AND a.bankroll_momento > 0::numeric THEN round(a.stake / a.bankroll_momento * 100::numeric, 2)
    ELSE NULL::numeric
  END AS stake_porcentaje_real,
  a.perfil_riesgo_usado,
  a.resultado,
  a.puntos_reales,
  a.ganancia,
  CASE
    WHEN a.stake > 0::numeric THEN round(
      COALESCE(a.ganancia, 0::numeric) / a.stake * 100::numeric,
      2
    )
    ELSE NULL::numeric
  END AS roi_porcentaje,
  CASE
    WHEN a.score_total IS NULL THEN 'SIN_SCORE'::text
    WHEN a.score_total >= 5.0 THEN 'EXCELENTE'::text
    WHEN a.score_total >= 3.0 THEN 'BUENA'::text
    WHEN a.score_total >= 1.0 THEN 'ACEPTABLE'::text
    WHEN a.score_total > 0::numeric THEN 'MARGINAL'::text
    ELSE 'NO_APTA'::text
  END AS clasificacion_calidad,
  CASE
    WHEN a.devig_metodo::text = 'no_aplicado'::text THEN true
    ELSE false
  END AS sin_devig,
  CASE
    WHEN a.devig_metodo::text = 'estimado'::text THEN true
    ELSE false
  END AS devig_estimado,
  CASE
    WHEN a.edge_real IS NOT NULL
    AND a.edge_real <= 0::numeric THEN true
    ELSE false
  END AS edge_negativo,
  CASE
    WHEN a.kelly_fraccional IS NOT NULL
    AND a.fraccion_kelly IS NOT NULL
    AND a.kelly_fraccional < (a.kelly_full * a.fraccion_kelly * 0.9) THEN true
    ELSE false
  END AS kelly_penalizado,
  a.creado_en,
  a.fecha_resolucion
FROM
  apuestas a
  JOIN usuarios u ON a.usuario_id = u.id

